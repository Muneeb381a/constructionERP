DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_erp

PORT=4000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Only needed on serverless deployments (e.g. Vercel) — secures the /api/admin/reconcile-all
# cron endpoint that replaces the in-process node-cron job, which can't run on serverless.
# Generate with `openssl rand -hex 32`; also set it as CRON_SECRET in the Vercel project.
CRON_SECRET=replace-with-a-long-random-secret

# Platform-admin (SaaS operator) auth — must be different values from JWT_ACCESS_SECRET /
# JWT_REFRESH_SECRET above, so a tenant-user token can never validate on a platform-admin
# route. Generate each with `openssl rand -hex 48`.
PLATFORM_ADMIN_JWT_ACCESS_SECRET=replace-with-a-long-random-secret
PLATFORM_ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
PLATFORM_ADMIN_ACCESS_TOKEN_TTL=10m
PLATFORM_ADMIN_REFRESH_TOKEN_TTL_DAYS=5
# Optional: comma-separated list of IPs allowed to attempt platform-admin login. Leave unset
# to allow any IP (still protected by password + TOTP + strict rate limiting).
# PLATFORM_ADMIN_IP_ALLOWLIST=203.0.113.10,203.0.113.11
